{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch .NET Web API",
      "type": "dotnet",
      "request": "launch",
      "preLaunchTask": "build",
      "projectPath": "${workspaceFolder}/Zodiac Crystal/Zodiac Crystal/Zodiac Crystal.csproj",
      "cwd": "${workspaceFolder}/Zodiac Crystal/Zodiac Crystal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Launch .NET Web API (CoreCLR)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Zodiac Crystal/Zodiac Crystal/bin/Debug/net10.0/Zodiac Crystal.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Zodiac Crystal/Zodiac Crystal",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
